{
  "name": "image-optimizer/demos/esbuild",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "image-optimizer/demos/esbuild/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-builders/custom-esbuild:application",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["angular-image-optimizer:build"],
      "options": {
        "outputPath": "dist/image-optimizer/demos/esbuild",
        "browser": "image-optimizer/demos/esbuild/src/main.ts",
        "tsConfig": "image-optimizer/demos/esbuild/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "image-optimizer/demos/esbuild/public"
          }
        ],
        "styles": ["image-optimizer/demos/esbuild/src/styles.css"],
        "plugins": [
          "./image-optimizer/demos/esbuild/plugins.js"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular-builders/custom-esbuild:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "image-optimizer/demos/esbuild:build:production"
        },
        "development": {
          "buildTarget": "image-optimizer/demos/esbuild:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "image-optimizer/demos/esbuild:build",
        "staticFilePath": "dist/image-optimizer/demos/esbuild/browser",
        "spa": true
      }
    }
  }
}
